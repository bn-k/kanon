// Generated by kan import.

schema Category {
  category-name: Text?
  description:   Text?
  picture:       Image?

  products: [Product] <- category
}

schema Customer {
  company-name:          Text?
  contact-name:          Text?
  contact-title:         Text?
  address:               Text?
  city:                  Text?
  region:                Text?
  postal-code:           Text?
  country:               Text?
  phone:                 Text?
  fax:                   Text?
  customer-demographics: [-> CustomerDemographic]?

  orders: [Order] <- customer
}

schema CustomerDemographic {
  customer-desc: Text?

  customers: [Customer] <- customer-demographics
}

schema Employee {
  last-name:         Text?
  first-name:        Text?
  title:             Text?
  title-of-courtesy: Text?
  birth-date:        Date?
  hire-date:         Date?
  address:           Prose?
  city:              Text?
  region:            Text?
  postal-code:       Text?
  country:           Text?
  home-phone:        Text?
  extension:         Text?
  photo:             Image?
  notes:             Text?
  reports-to:        -> Employee?
  photo-path:        Text?
  territories:       [-> Territory]

  employees: [Employee] <- reports-to
  orders:    [Order] <- employee
}

schema Order {
  customer:         -> Customer?
  employee:         -> Employee?
  order-date:       Date?
  required-date:    Date?
  shipped-date:     Date?
  ship-via:         -> Shipper?
  freight:          Number?
  ship-name:        Text?
  ship-address:     Text?
  ship-city:        Text?
  ship-region:      Text?
  ship-postal-code: Text?
  ship-country:     Text?
  order-details:    [OrderDetail]
}

schema OrderDetail {
  product:    -> Product
  unit-price: Number
  quantity:   Int
  discount:   Number
}

schema Product {
  product-name:      Text
  supplier:          -> Supplier?
  category:          -> Category?
  quantity-per-unit: Text?
  unit-price:        Number?
  units-in-stock:    Int?
  units-on-order:    Int?
  reorder-level:     Int?
  discontinued:      Text

  order-details: [OrderDetail] <- product
}

schema Region {
  region-description: Text

  territories: [Territory] <- region
}

schema Shipper {
  company-name: Text
  phone:        Text?

  orders: [Order] <- ship-via
}

schema Supplier {
  company-name:  Text
  contact-name:  Text?
  contact-title: Text?
  address:       Prose?
  city:          Text?
  region:        Text?
  postal-code:   Text?
  country:       Text?
  phone:         Text?
  fax:           Text?
  home-page:     Text?

  products: [Product] <- supplier
}

schema Territory {
  territory-description: Text
  region:                -> Region

  employees: [Employee] <- territories
}

schema Northwind {
  categories:            [Category]
  customer-demographics: [CustomerDemographic]?
  customers:             [Customer]
  employees:             [Employee]
  orders:                [Order]
  products:              [Product]
  regions:               [Region]
  shippers:              [Shipper]
  suppliers:             [Supplier]
  territories:           [Territory]
}
