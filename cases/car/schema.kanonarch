// Working material: a car maintenance log.

enum Operation { vidange, controle-technique, pneus, freins, distribution }

schema Entretien {
  date:        Date
  kilometrage: Quantity
  operation:   Operation
  garage:      Text?
  cout:        Money?
}

schema Vehicule {
  nom:                 Text @heading
  immatriculation:     Text
  mise-en-circulation: Date
  kilometrage:         Quantity
  releve-le:           Date
  intervalle-vidange:  Quantity
  entretiens:          [Entretien]
}

fn dernier(v: Vehicule, op: Operation) -> Entretien?
  reads fr "le dernier entretien {op} de {v.nom}"
  = v.entretiens.filter(e => e.operation == op).max-by(e => e.date)

// today is supplied by the tool, so the rule stays pure.
rule controle-technique-a-jour(v: Vehicule, le: Date = today) -> Bool
  reads fr "le dernier controle technique de {v.nom} a moins de 2 ans au {le}"
  = dernier(v, controle-technique)?.date + 2 years >= le

rule vidange-a-jour(v: Vehicule) -> Bool
  reads fr "{v.nom} a roule moins de {v.intervalle-vidange} depuis sa derniere vidange"
  = v.kilometrage - dernier(v, vidange)?.kilometrage < v.intervalle-vidange
