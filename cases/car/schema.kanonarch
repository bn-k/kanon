// Working material: a car maintenance log.

enum Operation { oil-change, inspection, tyres, brakes, timing-belt }

schema Service {
  date:      Date
  mileage:   Quantity
  operation: Operation
  garage:    Text?
  cost:      Money?
}

schema Vehicle {
  name:                Text @heading
  registration:        Text
  first-registered:    Date
  mileage:             Quantity
  read-on:             Date
  oil-change-interval: Quantity
  services:            [Service]
}

fn latest(v: Vehicle, op: Operation) -> Service?
  reads en "the latest {op} of {v.name}"
  = v.services.filter(s => s.operation == op).max-by(s => s.date)

// today is supplied by the tool, so the rule stays pure.
rule inspection-up-to-date(v: Vehicle, on: Date = today) -> Bool
  reads en "{v.name} passed its last inspection less than 2 years before {on}"
  = latest(v, inspection)?.date + 2 years >= on

rule oil-change-up-to-date(v: Vehicle) -> Bool
  reads en "{v.name} has covered less than {v.oil-change-interval} since its last oil change"
  = v.mileage - latest(v, oil-change)?.mileage < v.oil-change-interval
