// Working material: a home computer inventory, fictional.

enum Etat { bon, fragile, mort }

schema Disque {
  modele:   Text
  capacite: Quantity?
  etat:     Etat
  usage:    Text?
}

schema Machine {
  nom:             Text @heading
  role:            Text
  systeme:         Text
  processeur:      Text
  chiffrement:     Bool
  memoire:         Quantity
  carte-graphique: Text?
  bios:            Version?
  disques:         [Disque]
  notes:           Prose?
}

schema Parc {
  titre:    Text @heading
  machines: [Machine] @sections
}

rule bios-a-jour(m: Machine) -> Bool
  reads fr "{m.nom} a un BIOS en version 2003 ou plus, qui corrige la faille du demarrage securise"
  = m.bios == none or m.bios >= 2003
