// Working material: a home computer inventory, fictional.

enum Condition { good, fragile, dead }

schema Disk {
  model:     Text
  capacity:  Quantity?
  condition: Condition
  usage:     Text?
}

schema Machine {
  name:          Text @heading
  role:          Text
  system:        Text
  processor:     Text
  encrypted:     Bool
  memory:        Quantity
  graphics-card: Text?
  bios:          Version?
  disks:         [Disk]
  notes:         Prose?
}

schema Inventory {
  title:    Text @heading
  machines: [Machine] @sections
}

rule bios-up-to-date(m: Machine) -> Bool
  reads en "{m.name} has BIOS version 2003 or later, which fixes the secure boot flaw"
  = m.bios == none or m.bios >= 2003
