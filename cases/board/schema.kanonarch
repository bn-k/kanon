// The example of the README: the board of a small team, fictional.

enum Status { todo, doing, done }

schema Person {
  name:  Text
  email: Text
  tasks: [Task] <- owner
}

schema Task {
  title:  Text @heading
  status: Status
  owner:  -> Person
  due:    Date
  notes:  Prose?
}

schema Board {
  name:   Text @heading
  people: [Person]
  tasks:  [Task]
}

// The rule holds across documents: the tasks of a person are the files of board/tasks that name them as owner.
rule one-at-a-time(p: Person) -> Bool
  reads en "{p.name} works on one task at a time"
  = count(p.tasks, t => t.status == doing) <= 1
