// Working material: French business-to-business invoices.

schema Partie {
  nom:       Text
  adresse:   Text
  tva-intra: Text?
}

schema Ligne {
  designation:   Text
  quantite:      Number
  prix-unitaire: Money

  montant: Money = prix-unitaire * quantite
}

schema Facture {
  numero:     Text
  date:       Date
  echeance:   Date
  emetteur:   Partie
  client:     -> Partie
  lignes:     [Ligne]
  taux-tva:   Percent
  conditions: Prose

  total-ht:  Money = sum(lignes.montant)
  tva:       Money = round(total-ht * taux-tva, 0.01)
  total-ttc: Money = total-ht + tva
}

rule echeance-legale(f: Facture) -> Bool
  reads fr "le paiement est du au plus tard 60 jours apres la date de la facture (Code de commerce, art. L441-10)"
  = f.echeance <= f.date + 60 days
