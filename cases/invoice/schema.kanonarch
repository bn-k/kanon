// Working material: business-to-business invoices with VAT.

schema Party {
  name:       Text
  address:    Text
  vat-number: Text?
}

schema Line {
  description: Text
  quantity:    Number
  unit-price:  Money

  amount: Money = unit-price * quantity
}

schema Invoice {
  number:   Text
  date:     Date
  due:      Date
  issuer:   Party
  client:   -> Party
  lines:    [Line]
  vat-rate: Percent
  terms:    Prose

  net-total:   Money = sum(lines.amount)
  vat:         Money = round(net-total * vat-rate, 0.01)
  gross-total: Money = net-total + vat
}

rule payment-deadline(i: Invoice) -> Bool
  reads en "payment is due at most 60 days after the invoice date"
  = i.due <= i.date + 60 days
