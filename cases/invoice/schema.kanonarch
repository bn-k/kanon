// Working material: French business-to-business invoices.

schema Partie {
  nom:       Text
  adresse:   Text
  tva-intra: Text? "TVA intracommunautaire"
}

schema Ligne {
  designation:   Text "Désignation"
  quantite:      Number "Quantité"
  prix-unitaire: Money

  montant: Money = prix-unitaire * quantite
}

schema Facture {
  numero:     Text "Numéro"
  date:       Date
  echeance:   Date "Échéance"
  emetteur:   Partie "Émetteur"
  client:     -> Partie
  lignes:     [Ligne]
  taux-tva:   Percent "Taux de TVA"
  conditions: Prose

  total-ht:  Money "Total HT"  = sum(lignes.montant)
  tva:       Money "TVA"       = round(total-ht * taux-tva, 0.01)
  total-ttc: Money "Total TTC" = total-ht + tva
}

rule echeance-legale(f: Facture) -> Bool
  reads fr "le paiement est dû au plus tard 60 jours après la date de la facture (Code de commerce, art. L441-10)"
  = f.echeance <= f.date + 60 days
