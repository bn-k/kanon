// Working material: a training course whose modules are files, in the order their order lists give, linking to
// the trainers from the root folder.

schema Training {
  title:    Text @heading
  trainers: [Trainer]
  modules:  [Module]
}

schema Trainer {
  name: Text
}

schema Module {
  title:    Text @heading
  duration: Duration
  trainer:  -> Trainer
  modules:  [Module]?
}
