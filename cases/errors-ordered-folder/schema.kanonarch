// Working material: the order lists of ordered-folder, written wrong. Links from the root are read from this
// folder, so the schema is here and not in ../ordered-folder.

schema Formation {
  titre:      Text @heading
  formateurs: [Formateur]
  modules:    [Module]
}

schema Formateur {
  nom: Text
}

schema Module {
  titre:     Text @heading
  duree:     Duration
  formateur: -> Formateur
  modules:   [Module]?
}
