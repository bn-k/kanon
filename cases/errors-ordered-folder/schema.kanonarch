// Working material: the order lists of ordered-folder, written wrong. Links from the root are read from this
// folder, so the schema is here and not in ../ordered-folder.

schema Training {
  title:    Text @heading
  trainers: [Trainer]
  modules:  [Module]
}

schema Trainer {
  name: Text
}

schema Module {
  title:    Text @heading
  duration: Duration
  trainer:  -> Trainer
  modules:  [Module]?
}
