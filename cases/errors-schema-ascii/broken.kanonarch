// Working material: a schema is written in ASCII, comments and strings included.
// A résumé is written resume.
// An invoice n° is written "no".
// “Curly quotes” are refused.

schema Expense {
  title:  Text @heading
  amount: Money
}

rule cap(e: Expense) -> Bool
  reads en "a café bill stays under 500 EUR “unless agreed”"
  = e.amount <= 500 EUR
