// Working material: a schema is written in ASCII, comments and strings included.
// Un schéma s'écrit sans accents.
// Un n° de facture s'ecrit "no".
// Les guillemets « » sont refuses.

schema Depense {
  objet:   Text @heading
  montant: Money
}

rule plafond(d: Depense) -> Bool
  reads fr "le montant d'une dépense ne dépasse pas 500 EUR « sauf accord »"
  = d.montant <= 500 EUR
