// Working material: cooking recipes.

unit pinch

schema Recipe {
  title:       Text @heading
  servings:    Int
  preparation: Duration
  resting:     Duration?
  cooking:     Duration?
  ingredients: [Ingredient]
  steps:       [Prose]

  total-time: Duration = preparation + (resting ?? 0 min) + (cooking ?? 0 min)
}

// A list item such as "250 g of flour {#flour}" is read through this pattern; [of] is optional.
schema Ingredient reads "{quantity} [of] {name}" {
  quantity: Quantity
  name:     Text
}

fn scaled(r: Recipe, n: Int) -> Recipe
  reads en "{r.title} for {n} people"
  = r with {
      servings:    n,
      ingredients: r.ingredients.map(i => i with { quantity: i.quantity * n / r.servings }),
    }
