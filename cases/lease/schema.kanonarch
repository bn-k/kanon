// Working material: residential leases of unfurnished homes, each with its check-in report.

enum PersonType { individual, company }
enum Condition { new, good, worn, damaged }

schema Person {
  name:    Text
  type:    PersonType
  address: Text?
}

schema Dwelling {
  address: Text
  area:    Quantity
  rooms:   Int
}

schema Clause {
  title: Text  @heading
  body:  Prose @body
}

schema Lease {
  title:            Text @heading
  landlord:         Person
  tenant:           Person
  dwelling:         Dwelling
  start:            Date
  term:             Duration
  rent:             Money
  service-charge:   Money
  security-deposit: Money
  rent-controlled:  Bool
  clauses:          [Clause] @sections

  end:           Date = start + term
  notice-period: Duration = if rent-controlled then 1 month else 3 months
}

schema Room {
  room:      Text
  condition: Condition
  decor:     Text?
  notes:     Text?
}

schema CheckInReport {
  lease: -> Lease
  date:  Date
  keys:  Int
  rooms: [Room]
}

rule deposit-cap(l: Lease) -> Bool
  reads en "the security deposit is at most one month's rent, service charge excluded"
  = l.security-deposit <= l.rent

rule minimum-term(l: Lease) -> Bool
  reads en "a lease runs for at least 3 years, 6 years when the landlord is a company"
  = l.term >= (if l.landlord.type == company then 6 years else 3 years)

rule check-in-date(r: CheckInReport) -> Bool
  reads en "the check-in report is dated no later than the first day of the lease"
  = r.date <= r.lease.start
