// Working material: French unfurnished residential leases (loi no 89-462 du 6 juillet 1989).

enum TypePersonne { physique, morale }
enum Etat { neuf, bon, use, degrade }

schema Personne {
  nom:     Text
  type:    TypePersonne
  adresse: Text?
}

schema Logement {
  adresse: Text
  surface: Quantity
  pieces:  Int
}

schema Clause {
  titre: Text  @heading
  corps: Prose @body
}

schema Bail {
  titre:             Text @heading
  bailleur:          Personne
  locataire:         Personne
  logement:          Logement
  debut:             Date
  duree:             Duration
  loyer-hc:          Money
  charges:           Money
  depot-de-garantie: Money
  zone-tendue:       Bool
  clauses:           [Clause] @sections

  fin:               Date = debut + duree
  preavis-locataire: Duration = if zone-tendue then 1 month else 3 months
}

schema Piece {
  piece:     Text
  etat:      Etat
  remarques: Text?
}

schema EtatDesLieux {
  bail:   -> Bail
  date:   Date
  cles:   Int
  pieces: [Piece]
}

rule depot-plafonne(b: Bail) -> Bool
  reads fr "le depot de garantie ne depasse pas un mois de loyer hors charges (art. 22)"
  = b.depot-de-garantie <= b.loyer-hc

rule duree-minimale(b: Bail) -> Bool
  reads fr "le bail dure au moins 3 ans, 6 ans si le bailleur est une personne morale (art. 10)"
  = b.duree >= (if b.bailleur.type == morale then 6 years else 3 years)

rule etat-des-lieux-date(e: EtatDesLieux) -> Bool
  reads fr "l'etat des lieux d'entree est date au plus tard du premier jour du bail"
  = e.date <= e.bail.debut
