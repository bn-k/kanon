// Working material: a shared expense whose computed fields hold mistakes. The schema check finds them before any
// document is read.

schema Person {
  name: Text @heading
}

schema Expense {
  title:        Text @heading
  amount:       Money
  rate:         Percent
  date:         Date
  participants: [-> Person]

  share: Money  = amount / participants
  tip:   Money  = amount * rate + 5
  total: Money  = sum(participants, p => p.name)
  due:   Date   = date + 30 workdays
  paid:  Bool   = if amount then yes else no
  names: [Text] = participants.map(p => p.age)
  large: Bool   = amount > 1 25 EUR
}

rule shared(e: Expense) -> Bool
  reads en "{e.title} is shared between {e.participants}"
  = count(e.participants) > "1"
