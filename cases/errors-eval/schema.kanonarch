// Working material: a shared expense, split between the people who took part. Each person has a sponsor, who
// brought them into the group.

schema Personne {
  nom:     Text @heading
  parrain: -> Personne?

  rang: Int = (parrain?.rang ?? 0) + 1
}

schema Depense {
  objet:        Text @heading
  montant:      Money
  le:           DateTime
  paye-par:     -> Personne
  participants: [-> Personne]?

  part:   Money    = montant / count(participants)
  rappel: DateTime = le + 1.5 months
}
