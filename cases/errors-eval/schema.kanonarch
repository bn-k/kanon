// Working material: a shared expense, split between the people who took part. Each person has a sponsor, who
// brought them into the group.

schema Person {
  name:    Text @heading
  sponsor: -> Person?

  rank: Int = (sponsor?.rank ?? 0) + 1
}

schema Expense {
  title:        Text @heading
  amount:       Money
  at:           DateTime
  paid-by:      -> Person
  participants: [-> Person]?

  share:    Money    = amount / count(participants)
  reminder: DateTime = at + 1.5 months
}
