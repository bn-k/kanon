// Generated by kan import.

schema Book {
  title:     Text
  summary:   Prose?
  price:     Number?
  available: Bool
  sample:    File?
  copies:    [Copy]?

  loans:   [Loan] <- book
  members: [Member] <- books
}

schema Copy {
  shelf:  Text
  bought: Date?
}

schema Loan {
  book:       -> Book
  member:     -> Member?
  checked-by: -> Member
  lent-at:    DateTime
  returned:   Bool?
}

schema Member {
  name:    Text
  joined:  Date
  active:  Bool
  photo:   Image?
  sponsor: -> Member?
  books:   [-> Book]?

  loans:               [Loan] <- member
  loans-by-checked-by: [Loan] <- checked-by
  members:             [Member] <- sponsor
  visits:              [Visit] <- member
}

schema Visit {
  member: -> Member
  day:    Date
}

schema Library {
  books:   [Book]
  loans:   [Loan]
  members: [Member]
  visits:  [Visit]
}
